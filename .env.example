# ---- Chat ----------------------------------------------------------------
# Required for the Chat module. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ---- Studio --------------------------------------------------------------
# Optional. Without it the Studio still runs in preview mode (animated
# stand-in frames), so the whole shot-list / queue / timeline flow is usable.
# With it, shots render as real Gen-4 footage.
RUNWAY_API_KEY=

# Optional overrides — defaults shown.
# RUNWAY_BASE_URL=https://api.dev.runwayml.com/v1
# RUNWAY_API_VERSION=2024-11-06
# RUNWAY_MODEL=gen4_turbo
# RUNWAY_IMAGE_MODEL=gen4_image
