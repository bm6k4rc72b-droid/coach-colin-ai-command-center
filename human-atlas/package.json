{
  "name": "human-atlas",
  "private": true,
  "version": "1.0.0",
  "description": "Human Atlas: a full-screen 3D anatomy explorer built on BodyParts3D, with an exploded specimen-sheet view.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
