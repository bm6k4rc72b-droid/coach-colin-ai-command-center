    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.14"
  }
