{
  "name": "reel-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Coach Colin's Reel renderer: COLIN OS scripts in, 1080x1920 MP4 out. Remotion + optional VoiceStudio voice-over.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.jsx",
    "voiceover": "node scripts/voiceover.mjs",
    "render": "remotion render src/index.jsx ColinReel out/reel.mp4 --props=props.json",
    "still": "remotion still src/index.jsx ColinReel out/cover.png --props=props.json --frame=20",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.543"
  }
}
