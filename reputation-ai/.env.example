# Restaurant Reputation AI: copy to .env and fill in.
# Per-restaurant settings (name, brand voice, manager contacts, Google ids...)
# are NOT here: they live in the database. See "Add your restaurant" in README.

# ---------------------------------------------------------------- Mode ------
# true = mock reviews, mock Claude, and nothing is actually sent (SMS, email
# and Slack are written to the `outbox` table). Needs no other keys.
TEST_MODE=false
# In test mode Claude is mocked too. Set false (with ANTHROPIC_API_KEY) to try
# the real prompts on the mock reviews and calls.
# MOCK_LLM=false

# ---------------------------------------------------------------- Core ------
# Supabase: Project Settings > Database > Connection string (URI, "Session pooler").
# Leave blank to use a local SQLite file (fine for trying things out).
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Public HTTPS address of this server. Used in review links, QR codes and
# the URLs the voice agent calls. No trailing slash.
PUBLIC_BASE_URL=https://reputation.yourdomain.com
# Password for the dashboard and admin API. Generate: openssl rand -hex 24
ADMIN_TOKEN=
LOG_LEVEL=INFO
# Set false on extra web workers so background jobs run in exactly one process.
RUN_SCHEDULER=true

# ---------------------------------------------------------------- Claude ----
ANTHROPIC_API_KEY=
# claude-opus-5-5 is the default. claude-sonnet-5-5 costs about half as much
# and is a reasonable choice for this workload.
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high. Blank for older models that do not accept `effort`.
CLAUDE_EFFORT=medium
# "default" = if Claude's safety system declines a request, the API retries it
# on a fallback model. Blank to disable (needed for older models).
CLAUDE_FALLBACKS=default

# ------------------------------------------------- Module 1: Google reviews --
REVIEW_POLL_MINUTES=10
# Unreplied reviews older than this are imported but never answered.
MAX_REVIEW_AGE_DAYS=14
# OAuth client + refresh token for a Google account that manages the
# Business Profile location(s). See README > "Google Business Profile".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---------------------------------------------- Module 2: Twilio (SMS) -------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use ONE of these two. A Messaging Service is recommended for US A2P 10DLC.
TWILIO_FROM_NUMBER=+15125550100
TWILIO_MESSAGING_SERVICE_SID=
INVITE_COOLDOWN_DAYS=30
# Review invites are only sent between these hours, restaurant local time.
SMS_SEND_START_HOUR=9
SMS_SEND_END_HOUR=20

# ------------------------------------- Module 3: ElevenLabs voice agent ------
ELEVENLABS_API_KEY=
# Voice for the agent (ElevenLabs > Voices > copy voice ID). Blank = default.
ELEVENLABS_VOICE_ID=
# LLM that runs the live call, as named in the ElevenLabs agent settings.
# Blank = ElevenLabs default.
ELEVENLABS_AGENT_LLM=
# Signing secret shown when you create the post-call webhook in ElevenLabs.
ELEVENLABS_WEBHOOK_SECRET=
# Shared secret the agent sends with each tool call. Generate: openssl rand -hex 24
VOICE_TOOL_SECRET=

# ---------------------------------------------------------- Email (SMTP) -----
# Any SMTP provider (Resend, SendGrid, Postmark, Gmail app password...).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Reputation AI <alerts@yourdomain.com>

# Slack is configured per restaurant (slack_webhook_url), not here.
