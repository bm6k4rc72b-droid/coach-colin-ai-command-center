# Copy to .env and fill in. These never leave the edge box.
FRIGATE_MQTT_PASSWORD=change-me
RANCH_EDGE_MQTT_PASSWORD=change-me-too
FRIGATE_RTSP_PASSWORD=
# The dashboard's origin, for CORS. Add yours if you host it elsewhere.
ALLOWED_ORIGINS=https://bm6k4rc72b-droid.github.io
# Frigate camera names that watch calving pens — Cowcatcher runs on these.
CALVING_CAMERAS=
# Path inside the container to Cowcatcher weights (download from its model card into data/models).
COWCATCHER_WEIGHTS=
# A RF-DETR checkpoint fine-tuned on your ranch, and its class names.
RFDETR_WEIGHTS=
RFDETR_CLASSES=
