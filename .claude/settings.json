{
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail",
        "ref": "96608e078b2d5ea607c5c3b8b5a54d1c1fba6846"
      }
    },
    "lemolab": {
      "source": {
        "source": "github",
        "repo": "lemomo-ai/lemo-opuscar",
        "ref": "bc0992ae25f63c1780dd9cfe39a020e2deda79ec"
      }
    },
    "remotion": {
      "source": {
        "source": "github",
        "repo": "remotion-dev/claude-code-plugin",
        "ref": "3bece0db581f2835bd3ac7b5777399a104bcf4ff"
      }
    },
    "hyperframes": {
      "source": {
        "source": "github",
        "repo": "heygen-com/hyperframes",
        "ref": "7b1d9ccebf9c7e2c2bd22b7e9d9487ce975d6425"
      }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "lemo-opuscar@lemolab": true,
    "remotion@remotion": true,
    "hyperframes@hyperframes": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/install-ai-tools.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
